# Copy to examples/voice/custom/.env; run from the repository root.
# Exported environment variables override this file, including empty values.
# Base URLs include /v1, never /responses or /audio/... .
LLM_BASE_URL=http://100.77.77.177:8080/v1
LLM_API_KEY=
LLM_MODEL=unsloth/LFM2.5-1.2B-Instruct-GGUF
# LLM_MODEL=unsloth/Qwen3.5-122B-A10B-GGUF

# Required: your transcription server's base URL and accepted model identifier.
# Must accept multipart WAV (PCM16 at STT_SAMPLE_RATE) and return JSON {"text":"..."}.
# Opus decoder output rate: 8000, 12000, 16000, 24000 or 48000. Default: 16000.
STT_SAMPLE_RATE=16000
STT_CHANNELS=1
STT_BASE_URL=http://100.77.77.177:8081/v1
STT_API_KEY=
STT_MODEL=audio-cpp/audio.cpp-gguf:Nemotron-3.5-ASR-Streaming-0.6B-GGUF/nemotron-3.5-asr-streaming-0.6b-q8_0

# Required: your speech server's base URL, accepted model, and voice identifier.
# Raw signed PCM16 little-endian must match TTS_SAMPLE_RATE and TTS_CHANNELS.
# Source format for Supertonic 3; omitted settings default to 24000 Hz mono.
# WebRTC output remains 48000 Hz. This example does not downmix stereo.
TTS_SAMPLE_RATE=44100
TTS_CHANNELS=1
TTS_BASE_URL=http://100.77.77.177:8081/v1
TTS_API_KEY=
TTS_MODEL=audio-cpp/audio.cpp-gguf:Qwen3-TTS-12Hz-0.6B-Base-GGUF/qwen3-tts-12hz-0.6b-base-bf16
TTS_VOICE=lee_en
TTS_VOICE_DE=lee_de
TTS_VOICE_FR=lee_fr
# TTS_MODEL=audio-cpp/audio.cpp-gguf/Supertonic-3-GGUF
# TTS_VOICE=M1

# Empty API keys send Authorization: Bearer local-no-auth.
# Set each service's own key when authentication is enabled.
# ONNX Runtime is required for utterance segmentation and turn detection.
# Export JARGO_ONNXRUNTIME_LIB in the shell if not installed in a standard path.
# Only the service settings above are read from this file.
